{
 "说明": "Awesome 清单 · 本站分组体系用的分组：词表与每个清单的归属都是本站（语言模型）依据清单名称与描述判断的，没有经过人工验证。新进总榜的清单没有映射时归入“其他”组，需要时在 groups 里补一行；不是清单的仓库（只是名字或话题带 awesome）放进 exclude。",
 "vocabulary": {
  "lang": {
   "label": "编程语言",
   "definition": "某一门编程语言、运行时或平台（Python、Go、Rust、Java、C/C++、.NET、Node.js……）的库、框架与资源清单。"
  },
  "frontend": {
   "label": "前端与界面",
   "definition": "前端框架（React、Vue、Redux、Vite……）、组件库、界面库与前端工程化的清单。"
  },
  "backend": {
   "label": "后端与架构",
   "definition": "后端 Web 框架（Django、Flask、FastAPI、Laravel、NestJS）、GraphQL、微服务与系统架构的清单。"
  },
  "mobile": {
   "label": "移动与跨平台应用开发",
   "definition": "iOS、Android、Flutter、React Native、Electron 等移动与跨平台应用开发的库、工具与界面资源。"
  },
  "ai-ml": {
   "label": "机器学习与大模型",
   "definition": "机器学习、深度学习、自然语言处理、计算机视觉、大语言模型、生成式模型与 MLOps 的资源、论文与教程清单。"
  },
  "ai-agents": {
   "label": "AI 智能体、技能与工具",
   "definition": "AI 智能体、Claude 等智能体的技能与插件、MCP 服务、大模型接入与周边工具的清单。"
  },
  "data": {
   "label": "数据与大数据",
   "definition": "数据科学、大数据框架与数据处理资源的清单。"
  },
  "devtools": {
   "label": "开发工具与环境",
   "definition": "命令行、终端、Shell、编辑器（Vim、Neovim、VS Code）、Git 与 GitHub 使用、静态分析、低代码等开发辅助工具的清单。"
  },
  "ops": {
   "label": "运维与基础设施",
   "definition": "Docker、云服务、系统管理、自托管、隧道与内网穿透、免费云服务额度等运维与基础设施的清单。"
  },
  "security": {
   "label": "安全与隐私",
   "definition": "渗透测试、漏洞、CTF、开源情报、Web 安全与隐私保护的资源清单。"
  },
  "apps": {
   "label": "软件与应用合集",
   "definition": "按平台或用途收集好用软件的清单：macOS、Linux、iOS 应用、Python 写的应用、自托管应用、开源替代品。"
  },
  "learn": {
   "label": "学习、面试与职业",
   "definition": "给初学者的项目、从零造轮子的教程、面试题、远程工作、CTO 与独立开发者资源等学习与职业发展的清单。"
  },
  "cs": {
   "label": "计算机科学与工程实践",
   "definition": "设计模式、系统设计、函数式编程概念、编码规范等不绑定某一语言或工具的工程知识清单。"
  },
  "design": {
   "label": "设计与创意",
   "definition": "设计工具、设计系统与创意编程的清单。"
  },
  "fun": {
   "label": "游戏与娱乐",
   "definition": "开源游戏、游戏开发资源、影视与其他娱乐资源的清单。"
  },
  "hardware": {
   "label": "硬件",
   "definition": "具体硬件设备（如 Flipper Zero）的资源清单。"
  },
  "finance": {
   "label": "金融与区块链",
   "definition": "量化交易、系统化交易与区块链技术的清单。"
  },
  "meta": {
   "label": "清单的清单与综合资源",
   "definition": "收集其他清单的清单，以及不限定主题的综合资源汇总。"
  }
 },
