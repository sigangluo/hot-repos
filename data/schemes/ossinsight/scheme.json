{
 "name": "OSS Insight 开源项目合集",
 "summary": "PingCAP 的 OSS Insight 项目由社区维护的开源项目合集（如 Web 框架、静态站点生成器、开源数据库），把同一类开源项目收在一起。",
 "method": "curated",
